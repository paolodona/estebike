---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/layout/Hero.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import Icon from '../components/ui/Icon.astro';
import Card from '../components/ui/Card.astro';
import CardBody from '../components/ui/CardBody.astro';
import PhotoLightbox from '../components/ui/PhotoLightbox.astro';
import { url } from '../utils/base';

const fs = await import('node:fs');
const path = await import('node:path');

const photosPath = path.resolve('src/data/magna-2026-photos.json');
const rawPhotos: string[] = fs.existsSync(photosPath)
  ? JSON.parse(fs.readFileSync(photosPath, 'utf-8'))
  : [];

// Resolve descriptions (reuse the gallery descriptions file for alt text)
const descriptionsPath = path.resolve(
  'scripts/whatsapp-gallery/descriptions.json'
);
const descriptions: Record<string, string> = fs.existsSync(descriptionsPath)
  ? JSON.parse(fs.readFileSync(descriptionsPath, 'utf-8'))
  : {};

const eventPhotos = rawPhotos.map((p) => {
  const filename = p.split('/').pop() || '';
  const alt = descriptions[filename] || 'Foto Magna & Pedala 2026';
  return { src: url(p), alt };
});

const routes = [
  {
    name: 'Circuito Corto',
    distance: '11 km',
    elevation: '~20 m D+',
    difficulty: 'Facile',
    type: 'A piedi o in bici',
    description:
      'Adatto a famiglie e principianti. Un anello breve attorno al Castello.',
    color: 'success' as const,
    barColor: '#2E7D32',
    href: '/magna-e-pedala/2026/corto/',
  },
  {
    name: 'Circuito Gravel',
    distance: '48 km',
    elevation: '~430 m D+',
    difficulty: 'Medio',
    type: 'Gravel',
    description: 'Strade bianche e sentieri attraverso i Colli Euganei.',
    color: 'warning' as const,
    barColor: '#E8A000',
    href: '/magna-e-pedala/2026/gravel/',
  },
  {
    name: 'Circuito MTB',
    distance: '49 km',
    elevation: '~560 m D+',
    difficulty: 'Impegnativo',
    type: 'Mountain Bike',
    description:
      'I sentieri più belli dei Colli Euganei per ciclisti allenati.',
    color: 'error' as const,
    barColor: '#C41E3A',
    href: '/magna-e-pedala/2026/mtb/',
  },
];
---

<BaseLayout
  title="Magna & Pedala 2026 — 30° Anniversario EsteBike"
  description="Il racconto del 30° Magna & Pedala (10 maggio 2026, Este). Foto, tracce GPS dei tre percorsi e ringraziamenti a partecipanti, volontari e sponsor."
>
  <Hero
    title="30° Magna & Pedala — Grazie!"
    subtitle="EsteBike • 10 maggio 2026"
    location="Castello Carrarese, Este"
    image="/images/hero-default.jpg"
    size="large"
  />

  <!-- Recap intro -->
  <section class="section">
    <div class="container">
      <div class="recap-intro text-center">
        <Badge variant="accent">30° Anniversario</Badge>
        <h2>Una giornata indimenticabile</h2>
        {/* TODO: personalizzare il racconto con numeri e aneddoti reali */}
        <p>
          Il <strong>10 maggio 2026</strong> abbiamo festeggiato insieme la trentesima
          edizione del Magna & Pedala. Tre percorsi attraverso i Colli Euganei, ristori
          con prodotti locali, tanto sport e un'atmosfera di festa che resterà nei
          nostri ricordi.
        </p>
        <p>
          Grazie a tutte le persone che hanno reso possibile questa giornata:
          partecipanti, volontari, sponsor e amici del territorio.
        </p>
      </div>
    </div>
  </section>

  <!-- Routes (relive) -->
  <section class="section section--bg-image" id="percorsi">
    <div class="container">
      <div class="section-header text-center">
        <h2>Rivivi i percorsi</h2>
        <p>
          Le tracce GPS dei tre circuiti dell'edizione 2026 sono pubbliche. Puoi
          ripercorrerle quando vuoi.
        </p>
      </div>

      <div class="routes-grid">
        {
          routes.map((route) => (
            <Card variant="event">
              <div
                class="route-color-bar"
                style={`background-color: ${route.barColor};`}
              />
              <CardBody>
                <div class="route-head">
                  <Badge variant={route.color} size="sm">
                    {route.difficulty}
                  </Badge>
                  <span class="route-type">{route.type}</span>
                </div>
                <h3 class="route-title">{route.name}</h3>
                <div class="route-stats">
                  <div class="route-stat">
                    <span class="route-stat__value">{route.distance}</span>
                    <span class="route-stat__label">Distanza</span>
                  </div>
                  <div class="route-stat">
                    <span class="route-stat__value">{route.elevation}</span>
                    <span class="route-stat__label">Dislivello</span>
                  </div>
                </div>
                <p class="route-description">{route.description}</p>
                <Button href={route.href} variant="secondary" size="sm">
                  Apri il percorso
                  <Icon name="arrow-right" size={16} />
                </Button>
              </CardBody>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Event Photos -->
  {
    eventPhotos.length > 0 && (
      <section class="section" id="foto">
        <div class="container">
          <div class="section-header text-center">
            <h2>Le foto della giornata</h2>
            <p>{eventPhotos.length} momenti scelti dell'edizione 2026</p>
          </div>

          <div class="photo-grid">
            {eventPhotos.map((photo) => (
              <button
                class="photo-item"
                data-lightbox
                data-src={photo.src}
                data-alt={photo.alt}
                data-gallery="magna-2026"
              >
                <img src={photo.src} alt={photo.alt} loading="lazy" />
              </button>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Sponsors / Thanks -->
  <section class="section section--bg-image">
    <div class="container">
      <div class="section-header text-center">
        <h2>Grazie ai nostri sponsor e volontari</h2>
        <p>Senza il loro supporto il Magna & Pedala non sarebbe possibile.</p>
      </div>

      {
        /* TODO: aggiungere logo / lista sponsor 2026 e ringraziamento volontari */
      }
      <p class="thanks-note text-center">
        Un grazie speciale a tutti i volontari che hanno presidiato i ristori e
        i bivi, alla <strong>Comune di Este</strong>, agli enti del territorio e
        a tutti gli sponsor che hanno sostenuto la 30ª edizione.
      </p>
    </div>
  </section>

  <PhotoLightbox />
</BaseLayout>

<style>
  /* Background Image Sections */
  .section--bg-image {
    position: relative;
    background: url('/images/colli-euganei-bg.jpg') center/cover no-repeat fixed;
  }

  .section--bg-image::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.88);
  }

  .section--bg-image > .container {
    position: relative;
    z-index: 1;
  }

  /* Recap intro */
  .recap-intro {
    max-width: 720px;
    margin: 0 auto;
  }

  .recap-intro h2 {
    margin: var(--space-4) 0;
  }

  .recap-intro p {
    color: var(--color-gray-700);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  /* Section Header */
  .section-header {
    margin-bottom: var(--space-8);
  }

  .section-header h2 {
    margin-bottom: var(--space-2);
  }

  .section-header p {
    color: var(--color-gray-600);
    margin: 0;
  }

  /* Routes */
  .routes-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .routes-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .route-color-bar {
    height: 4px;
    width: 100%;
  }

  .route-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .route-type {
    font-size: var(--text-xs);
    color: var(--color-gray-500);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .route-title {
    font-size: var(--text-xl);
    margin: var(--space-3) 0 var(--space-4);
  }

  .route-stats {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-gray-200);
  }

  .route-stat {
    display: flex;
    flex-direction: column;
  }

  .route-stat__value {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-primary);
  }

  .route-stat__label {
    font-size: var(--text-xs);
    color: var(--color-gray-600);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .route-description {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-4);
  }

  /* Photo grid */
  .photo-grid {
    display: grid;
    gap: 4px;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 640px) {
    .photo-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 900px) {
    .photo-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .photo-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .photo-item {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-md);
    cursor: pointer;
    background: var(--color-gray-100);
    border: none;
    padding: 0;
    position: relative;
  }

  .photo-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.2s ease,
      filter 0.2s ease;
  }

  .photo-item:hover img {
    transform: scale(1.03);
    filter: brightness(0.9);
  }

  .photo-item:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Thanks */
  .thanks-note {
    max-width: 720px;
    margin: 0 auto;
    color: var(--color-gray-700);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }
</style>
